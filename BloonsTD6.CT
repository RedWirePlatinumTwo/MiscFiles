  <UserdefinedSymbols/>
  <LuaScript>if getOpenedProcessID() ~= 0 then
  local function init(name, value, func)
    if not getAddressSafe(name) then
       local address = allocateMemory(4)
       registerSymbol(name, address, true)
       func(address, value)
    end
  end
  local function initF(name, value)
        init(name, value, writeFloat)
  end

  init("bloonMultiplier", 10, writeInteger)
  initF("customDamage", 1000000)
  initF("customPierce", 100000)
  initF("upgradeMultiplier", 0)
  initF("baseTowerMultiplier", 0)
  initF("abilityMultiplier", 0)
  initF("atkSpeedMultiplier", 0)
  initF("cashPerPopAmount", 1000)
  initF("sellbackMod", 0.3)
  initF("bloonSpeedMulti", 0.5)
  initF("monkeyMoneyReward", 1000000)
  init("konFuzeValue", 900000000, writeDouble)
  init("powerQuantity", 999, writeInteger)
end

</LuaScript>
</CheatTable>

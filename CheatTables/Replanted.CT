  <UserdefinedSymbols/>
  <LuaScript>if getOpenedProcessID() ~= 0 then
  local function init(name, value, func)
    if not getAddressSafe(name) then
       local address = allocateMemory(4)
       registerSymbol(name, address, true)
       func(address, value)
    end
  end
  local function initInt(name, value)
      init(name, value, writeInteger)
  end
   initInt("Firerate", 2)
   initInt("HPAmount", 8000)
   initInt("LastStandFlag", 50)
   initInt("KernelButter", 0)
end

</LuaScript>

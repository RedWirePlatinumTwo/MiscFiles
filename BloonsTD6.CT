  <UserdefinedSymbols/>
  <LuaScript>local function initializeValues()
    local function init(name, value, func)
      if not getAddressSafe(name) then
         local address = allocateMemory(4)
         registerSymbol(name, address, true)
         func(address, value)
      end
    end

  init("bloonMultiplier", 10, writeInteger)
  init("customDamage", 100000, writeFloat)
  init("customPierce", 100000, writeFloat)
end

if getOpenedProcessID() ~= 0 then
   initializeValues()
end

</LuaScript>
